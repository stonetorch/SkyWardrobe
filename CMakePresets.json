        "ENABLE_SKYRIM_SE": "ON",
        "ENABLE_SKYRIM_AE": "ON",
        "ENABLE_SKYRIM_VR": "OFF",

        "CAF_UI_LANGUAGE": "zh-CN",

        "AUTO_DEPLOY": "ON",
