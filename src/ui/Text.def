CAF_TEXT(kFreezeControllerSimulation, "Freeze controller simulation", "冻结控制器模拟")
CAF_TEXT(kSuppressControllerGravity, "Suppress controller gravity", "抑制控制器重力")
CAF_TEXT(kSuppressSupportStepsGroundTilt, "Suppress support / steps / ground tilt", "抑制支撑 / 台阶 / 地面倾斜")
CAF_TEXT(kSuppressPhysicalPushing, "Suppress physical pushing", "抑制物理推挤")
CAF_TEXT(kFreezeRigidBodyMassGravityVelocities, "Freeze rigid-body mass / gravity / velocities", "冻结刚体质量 / 重力 / 速度")
CAF_TEXT(kBlockVanillaMovementDelta, "Block vanilla movement delta", "阻止原版移动增量")
CAF_TEXT(kFilterActorToActorBodyCollisions, "Filter actor-to-actor body collisions", "过滤角色之间的身体碰撞")
CAF_TEXT(kDisableFootIKGroundAlignment, "Disable Foot IK / ground alignment", "禁用脚部 IK / 地面对齐")
CAF_TEXT(kDisableHeadTracking, "Disable head tracking", "禁用头部追踪")
CAF_TEXT(kFilterStaggerRecoilBlockReactions, "Filter stagger / recoil / block reactions", "过滤硬直 / 后坐 / 格挡反应")
CAF_TEXT(kDisablePrecisionActorPhysicsViaAPI, "Disable Precision actor physics via API", "通过 API 禁用 Precision 角色物理")
CAF_TEXT(kDisableWholeActorCollisionDuringScenes, "Disable whole-actor collision during scenes", "场景期间禁用整个角色的碰撞")
CAF_TEXT(kAlsoIsolateCAFOriginalMotionModes, "Also isolate CAF / original motion modes", "同时隔离 CAF / 原始位移模式")
CAF_TEXT(kSimulationSupportAndPushingClearCachedVelocitiesRigidBody, "Simulation, support and pushing clear cached velocities. Rigid-body and movement isolation can prevent animation locomotion. Scene-wide collision disable overrides collision comparisons; turn it off when testing individual layers. Options last until the plugin is restarted.", "模拟、支撑和推挤隔离会清除缓存速度。刚体与移动隔离可能阻止动画位移。场景整体禁用碰撞会覆盖碰撞比较；测试单独层时请关闭。选项持续到插件重启。")
CAF_TEXT(kRestoreIsolationDefaults, "Restore isolation defaults", "恢复隔离默认值")
